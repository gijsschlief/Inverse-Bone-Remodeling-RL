from __future__ import print_function
import numpy as np

def forward_model_input_test(force_profile, initial_density, time_steps, dt, parameters):
    """
    This function test if the inputs are valid for the forward model and provides error and warning methods for invalid inputs.

    Parameters:
        force_profile (np.ndarray): Force profile matrix.
        initial_density (np.ndarray): Initial bone density matrix.
        time_steps (int): Number of time steps for the simulation.
        dt (float): Time step size.
        parameters (dict): Parameters for the forward model, including:
            - 'file_location': Location of the data files.
            - 'rho_min': Minimum bone density.
            - 'rho_max': Maximum bone density.

    Returns:
        None: If all inputs are valid.
        str: Error message if any input is invalid.
    """
    if not isinstance(force_profile, np.ndarray):
        return "Error: force_profile must be a numpy array."
    if not isinstance(initial_density, np.ndarray):
        return "Error: initial_density must be a numpy array."
    if not isinstance(time_steps, int) or time_steps <= 0:
        return "Error: time_steps must be a positive integer."
    if not isinstance(dt, (int, float)) or dt <= 0:
        return "Error: dt must be a positive number."
    if not isinstance(parameters, dict):
        return "Error: parameters must be a dictionary."
    if 'file_location' not in parameters or not isinstance(parameters['file_location'], str):
        return "Error: parameters must contain a valid 'file_location' string."
    if 'rho_min' not in parameters or not isinstance(parameters['rho_min'], (int, float)):
        return "Error: parameters must contain a valid 'rho_min' value."
    if 'rho_max' not in parameters or not isinstance(parameters['rho_max'], (int, float)):
        return "Error: parameters must contain a valid 'rho_max' value."
    if parameters['rho_min'] < 0 or parameters['rho_max'] <= parameters['rho_min']:
        return "Error: rho_min must be non-negative and rho_max must be greater than rho_min."
    if force_profile.shape != initial_density.shape:
        return "Error: force_profile and initial_density must have the same shape."
    if not (0 <= initial_density).all() or not (initial_density <= 1).all():
        return "Error: initial_density values must be between 0 and 1."
    if not (0 <= force_profile).all():
        return "Error: force_profile values must be non-negative."
    if not (0 <= parameters['rho_min']) or not (parameters['rho_max'] <= 1.74):
        return "Error: rho_min must be non-negative and rho_max must be less than or equal to 1.74."
    if not (0 <= dt <= 1):
        return "Error: dt must be between 0 and 1."
    if not (0 <= time_steps <= 1000):
        return "Error: time_steps must be between 0 and 1000."
    # If all checks pass, return None indicating no errors

    return None

if __name__ == "__main__":
    force_profile = np.random.rand(10, 10)  # Example force profile
    initial_density = np.full((10, 10), 0.8)  # Initial density matrix
    time_steps = 100  # Number of time steps
    dt = 1.0  # Time step size
    parameters = {
        'file_location': 'bone_inverse_rl/data/raw',
        'rho_min': 0.01,
        'rho_max': 1.74,
    }

    error_message= forward_model_input_test(force_profile, initial_density, time_steps, dt, parameters)
    print("Final Density:", error_message)